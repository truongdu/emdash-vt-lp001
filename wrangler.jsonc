{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdash-vt-lp001",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "run_worker_first": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash-vt-lp001",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "388fb96f0869485987654c352fcb92a3",
		},
	],
	// Sandboxed plugins require a Workers paid plan.
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
