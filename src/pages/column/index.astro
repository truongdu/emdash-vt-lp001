---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 10,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

function formatDate(d?: Date | null) {
	if (!d) return "";
	const dd = String(d.getDate()).padStart(2, "0");
	const mm = String(d.getMonth() + 1).padStart(2, "0");
	return `${dd}.${mm}.${d.getFullYear()}`;
}
---

<Base title="Chuyên mục" bodyId="column" bodyClass="under under_column">
	<div id="topic_path">
		<ul>
			<li><a href="/">Trang chủ</a></li>
			<li>Chuyên mục</li>
		</ul>
	</div>
	<div class="inner">
		<div class="column_content">
			<div class="column_list">
				{posts.length === 0 ? (
					<p>Chưa có bài viết nào.</p>
				) : (
					posts.map((post) => (
						<div class="column_detail">
							<a href={`/column/${post.id}`}></a>
							<p class="column_image">
								{post.data.featured_image ? (
									<Image image={post.data.featured_image} />
								) : (
									<img src="/assets/images/news_img_dummy.jpg" width="240" height="180" alt={post.data.title} />
								)}
							</p>
							<div>
								<p class="column_date">{formatDate(post.data.publishedAt)}</p>
								<dl>
									<dt>{post.data.title}</dt>
									{post.data.excerpt && <dd>{post.data.excerpt}</dd>}
								</dl>
							</div>
						</div>
					))
				)}

				<div class="pager">
					{cursor && <a href="/column/">« Về đầu</a>}
					{nextCursor && (
						<a href={`/column/?cursor=${encodeURIComponent(nextCursor)}`}>Xem thêm »</a>
					)}
				</div>
			</div>
		</div>
	</div>
</Base>
