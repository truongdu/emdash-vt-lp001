---
interface Item {
	question: string;
	answer: string;
}
interface Props {
	value: { heading?: string | null; items?: Item[] | null };
}
const { value } = Astro.props;
const items = value.items ?? [];
---

<section class="sec_faq">
	<div class="inner" id="faq">
		<h3 class="title" data-aos="fade-up">
			<span class="en yel">Faq</span>
			<span class="vn">{value.heading}</span>
		</h3>
		<div class="faq_list" data-aos="fade-up">
			{items.map((item) => (
				<dl>
					<dt><span class="en">Q</span>{item.question}</dt>
					<dd>
						<span class="en">A</span>
						<p set:html={item.answer.replace(/\n/g, "<br />")}></p>
					</dd>
				</dl>
			))}
		</div>
	</div>
</section>
