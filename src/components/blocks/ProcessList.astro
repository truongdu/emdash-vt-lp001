---
interface Item {
	number: number;
	text: string;
}
interface Props {
	value: { heading?: string | null; items?: Item[] | null };
}
const { value } = Astro.props;
const items = value.items ?? [];
---

<section class="sec_process" id="process">
	<div class="inner">
		<h3 class="title left">
			<span class="en yel">Process</span>
			<span class="vn">{value.heading}</span>
		</h3>
		<div class="sec_process_list">
			<ul>
				{items.map((item, i) => (
					<li data-aos="fade-up" data-aos-delay={200 + i * 100}>
						<span class="numb">{item.number}</span>{item.text}
					</li>
				))}
			</ul>
		</div>
		<div class="animate_process ani_lottie">
			<lottie-player src="/assets/json/process.json" background="transparent" speed="2" class="canvas_process" loop autoplay></lottie-player>
		</div>
	</div>
</section>
