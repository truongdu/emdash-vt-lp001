---
interface Item {
	number: string;
	text: string;
}
interface Props {
	value: { heading?: string | null; items?: Item[] | null };
}
const { value } = Astro.props;
const items = value.items ?? [];
---

<section class="sec_strength">
	<div class="inner" data-aos="fade-up">
		<h3 class="title" id="strength">
			<span class="en">Strength</span>
			<span class="vn">{value.heading}</span>
		</h3>

		<ul class="strength_list" data-aos="fade-up">
			{items.map((item) => (
				<li>
					<span class="numb">{item.number}</span>
					<span class="txt" set:html={item.text}></span>
				</li>
			))}
		</ul>
	</div>
</section>
